[nagios]
url = http://monitor.example.com/nagios
username = nagiosadmin

[auth]
# Authentication method: password, pass_path, or env_var
method = pass_path
# For method = password:
# password = your-password
# For method = pass_path (password-store):
pass_path = nagios/admin
# For method = env_var:
# env_var = NAGIOS_PASSWORD

[settings]
timeout = 30
verify_ssl = false
# strftime format Nagios uses for cmd.cgi start_time fields. Must match
# the cgi.cfg `date_format` directive on the server:
#   us    -> %m-%d-%Y %H:%M:%S  (default; e.g. "12-31-2026 23:59:59")
#   euro  -> %d-%m-%Y %H:%M:%S
#   iso8601 / strict-iso8601 -> %Y-%m-%d %H:%M:%S
# start_time_format = %m-%d-%Y %H:%M:%S
